
# Supabase PostgreSQL Connection String
# ได้จาก: Supabase Dashboard → Connect → Connection Pooler → Mode: Session → URI
DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Session Secret (สร้างด้วย: python -c "import secrets; print(secrets.token_urlsafe(64))")
# SESSION_SECRET=your-secret-key-here

# Environment
# ENV=production
